# ---------------------------------------------------------------------------
# n8nDemo environment template
#
# Do NOT edit this file for local use. Run ./bootstrap.sh instead - it copies
# this template to .env, fills in the absolute data directory and generates a
# cryptographically random encryption key.
#
# .env is git-ignored. This template is committed.
# ---------------------------------------------------------------------------

# n8n image tag. Pinned on purpose - do not use "latest", it makes the stack
# non-reproducible. Bump deliberately, then run: ./n8n.sh restart
N8N_VERSION=1.123.91

# Host port bound to 127.0.0.1 only (loopback). The UI, the REST API and the
# webhook endpoints are all served from this single port.
N8N_PORT=5678

# Absolute path to the interface directory on the host.
# bootstrap.sh replaces this with "$HOME/docker/n8n_data" expanded.
# Two subdirectories are created inside it:
#   .n8n/  -> n8n internal state (SQLite DB, encryption key, logs)
#   files/ -> file exchange between the host and workflows (/data/files)
N8N_DATA_DIR=__FILL_ME_ABSOLUTE_PATH__

# Key used to encrypt stored credentials at rest.
# bootstrap.sh generates this with: openssl rand -hex 32
#
# WARNING: back this value up. Restoring the data directory without the same
# key leaves every stored credential permanently unreadable.
N8N_ENCRYPTION_KEY=__FILL_ME_RANDOM_HEX__

# Timezone used by Schedule/Cron nodes and by the container clock.
GENERIC_TIMEZONE=Europe/Prague
